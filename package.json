{
  "name": "pau-shop",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix pau-shop-backend\" \"npm run dev --prefix pau-shop-frontend\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:backend": "npm test --prefix pau-shop-backend",
    "test:frontend": "npm test --prefix pau-shop-frontend",
    "test:e2e": "playwright test",
    "test:e2e:stripe": "cross-env LIVE_STRIPE=1 playwright test",
    "test": "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "sync:catalog": "node scripts/db-sync.mjs catalog",
    "sync:prod-to-test": "node scripts/db-sync.mjs prod-to-test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.95.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "pg": "^8.23.1",
    "supabase": "^2.119.0"
  }
}
